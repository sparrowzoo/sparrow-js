# 常量配置
NODE_ENV=production
NEXT_PUBLIC_TOKEN_STORAGE=COOKIE
NEXT_PUBLIC_TOKEN_KEY=sparrow_sso_token
NEXT_PUBLIC_TOKEN_COOKIE_DOMAIN=sparrowzoo.com
NEXT_PUBLIC_TOKEN_COOKIE_DAYS=14
NEXT_PUBLIC_TOKEN_COOKIE_SAME_SITE=Lax
NEXT_PUBLIC_TOKEN_COOKIE_SECURE=true
NEXT_PUBLIC_LOGIN_URL=/sign-in
NEXT_PUBLIC_USER_CATEGORY_ADMIN=2

# 后台接口
NEXT_PUBLIC_API=https://api.sparrowzoo.com
NEXT_PUBLIC_UPLOAD_URL=https://api.sparrowzoo.com/upload.json
NEXT_PUBLIC_CAPTCHA_URL=https://api.sparrowzoo.com/captcha

# 认证逻辑
NEXT_PUBLIC_ALLOW_ORIGINS=https://www.sparrowzoo.com,https://admin.sparrowzoo.com,https://im.sparrowzoo.com,https://passport.sparrowzoo.com,https://api.sparrowzoo.com
NEXT_PUBLIC_STORAGE_PROXY=https://passport.sparrowzoo.com/cros-storage/
NEXT_PUBLIC_CROS_DEBUG=false

# 资源文件
NEXT_PUBLIC_ASSET_PREFIX=
NEXT_PUBLIC_VISITOR_AVATAR_URL=https://r.sparrowzoo.net/avatar/visitor.jpg
## 用户未上传上头时的默认头象
NEXT_PUBLIC_AVATAR_URL=https://r.sparrowzoo.net/avatar/%s.jpg

# 前端首页导航
NEXT_PUBLIC_WWW_ROOT=https://www.sparrowzoo.com
NEXT_PUBLIC_PASSPORT_ROOT=https://passport.sparrowzoo.com
NEXT_PUBLIC_ADMIN_ROOT=https://admin.sparrowzoo.com
NEXT_PUBLIC_IM_ROOT=https://im.sparrowzoo.com
NEXT_PUBLIC_BLOG_ROOT=https://blog.sparrowzoo.com/article
