NODE_ENV=development
NEXT_PUBLIC_API=http://localhost:8888
# 留空以使用 IM 当前站点的静态资源，避免加载其他产品的 Next.js chunks。
NEXT_PUBLIC_ASSET_PREFIX=
NEXT_PUBLIC_WEBSOCKET=ws://localhost:8080/websocket
NEXT_PUBLIC_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
NEXT_PUBLIC_STORAGE_PROXY=http://localhost:3001/cros-storage/
NEXT_PUBLIC_TOKEN_STORAGE=SESSION
NEXT_PUBLIC_TOKEN_KEY=Authorization
NEXT_PUBLIC_LOGIN_URL=/sign-in
NEXT_PUBLIC_UPLOAD_URL=http://localhost:8888/upload.json
NEXT_PUBLIC_AVATAR_URL=http://localhost:3001/avatar/%s.jpg
NEXT_PUBLIC_GROUP_AVATAR_URL=http://localhost:3001/group/%s.jpg
NEXT_PUBLIC_WWW_ROOT=http://localhost:3000
NEXT_PUBLIC_ADMIN_ROOT=http://localhost:3002



NEXT_PUBLIC_VISITOR_AVATAR_URL=/avatar/visitor.jpg
NEXT_PUBLIC_SESSION_CATEGORY_GROUP={"2":[0,3,5],"5":[0,3]}
NEXT_PUBLIC_SESSION_CATEGORY_NAME_MAPPING={"0":"VISITOR","1":"REGISTER","3":"STUDENT","5":"AFFILIATE","6":"SERVER"}
NEXT_PUBLIC_SERVER_ID_ARRAY = 1,3

# 产品导航入口；IM 由共享导航按当前语言追加 /{locale}。
NEXT_PUBLIC_IM_ROOT=http://localhost:3003
NEXT_PUBLIC_CODER_ROOT=http://localhost:3002
NEXT_PUBLIC_PASSPORT_ROOT=http://localhost:3001
